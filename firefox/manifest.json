{
  "manifest_version": 2,
  "name": "Open in Normal Window",
  "description": "Opens links from incognito mode in a normal window.",
  "version": "1.0.0",
  "icons": {
	  "16": "icons/icon16.png",
	  "32": "icons/icon32.png",
	  "48": "icons/icon48.png",
	  "128": "icons/icon128.png"
	},
  "permissions": ["activeTab", "contextMenus", "tabs", "scripting"],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_action": {
    "default_title": "Open in Normal Window"
  }
}
